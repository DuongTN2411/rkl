  "item": [
    {
      "name": "1. Lấy đơn hàng paid, limit=3",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 200\", () => {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', true);",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.meta).to.have.property('total');",
              "  pm.expect(json.data).to.have.lengthOf(3);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/users/2/orders?status=paid&limit=3",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "users",
            "2",
            "orders"
          ],
          "query": [
            {
              "key": "status",
              "value": "paid"
            },
            {
              "key": "limit",
              "value": "3"
            }
          ]
        }
      }
    },
