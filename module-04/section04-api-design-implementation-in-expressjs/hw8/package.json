{
  "name": "hw8-newman",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "test:api": "newman run postman/collection.json -e postman/env.json --reporters cli,htmlextra --reporter-htmlextra-export reports/report.html",
    "test:api:auto": "start-server-and-test start http://localhost:3000/health test:api"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1",
    "start-server-and-test": "^2.0.9"
  }
}
