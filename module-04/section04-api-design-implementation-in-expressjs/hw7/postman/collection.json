    {
      "name": "5. userId không tồn tại (lỗi 404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code là 404\", () => {",
              "  pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Response đúng cấu trúc đã thiết kế\", () => {",
              "  const json = pm.response.json();",
              "  pm.expect(json).to.have.property('success', false);",
              "  pm.expect(json.error).to.have.property('code', 'USER_NOT_FOUND');",
              "  pm.expect(json.error).to.have.property('status', 404);",
              "});"
            ]
          }
        }
